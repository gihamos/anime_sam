# MongoDB — même serveur qu'anime_sama, base logique distincte (isolation des données)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=anime_sama_shop

# --- Authentification JWT (indépendante d'anime_sam) ---
# OBLIGATOIRE : choisir une clé secrète longue et aléatoire, DIFFÉRENTE du JWT_SECRET d'anime_sam
SHOP_JWT_SECRET=changeme-please-use-a-strong-secret

# Compte admin de la boutique créé automatiquement au premier démarrage (si DB vide)
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=admin

SHOP_PORT=8010

# --- Jellyfin (provisioning des comptes clients) ---
JELLYFIN_BASE_URL=http://jellyfin:8096
# Clé d'API dédiée, générée via POST /Auth/Keys — jamais le compte admin humain
JELLYFIN_API_KEY=

# --- PayPal (abonnements récurrents) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox par défaut — passer à https://api-m.paypal.com en production
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# URL publique de shop_app (retours PayPal après approbation)
SHOP_PUBLIC_URL=http://localhost:5173
