BASE_SAMA_URL=https://anime-sama.to/

# MongoDB sans auth
MONGODB_URL=mongodb://localhost:27017
# MongoDB avec auth
# MONGODB_URL=mongodb://username:password@localhost:27017/?authSource=admin
# MongoDB Atlas
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/

MONGODB_DB=anime_sama

# Proxy Playwright (optionnel — utile si le réseau bloque anime-sama.to)
# Format HTTP  : PLAYWRIGHT_PROXY=http://host:port
# Format SOCKS5: PLAYWRIGHT_PROXY=socks5://host:port
# Avec auth    : PLAYWRIGHT_PROXY=http://user:pass@host:port
# PLAYWRIGHT_PROXY=

# --- Authentification JWT ---
# OBLIGATOIRE en production : choisir une clé secrète longue et aléatoire
JWT_SECRET=changeme-please-use-a-strong-secret
# Durée de validité des tokens en minutes (défaut : 1440 = 24 h)
# JWT_EXPIRE_MINUTES=1440

# Compte admin créé automatiquement au premier démarrage (si DB vide)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- AniList / DeepL (enrichissement métadonnées) ---
# API GraphQL publique AniList, aucune clé requise
# ANILIST_API_URL=https://graphql.anilist.co
# ANILIST_RATE_LIMIT_PER_MIN=90
ANILIST_ENRICHMENT_ENABLED=true

# Traduction FR du synopsis (fallback si anime-sama.to n'en fournit pas) — laisser vide pour désactiver
DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# --- TMDB / Vidzy (films & séries — 2e source de contenu, indépendante d'anime-sama.to) ---
# Clé API TMDB (v3) — obligatoire pour la recherche/ajout de films et séries
TMDB_API_KEY=
# TMDB_API_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Service d'embed vidéo par TMDB id, public, aucune clé requise
# VIDZY_BASE_URL=https://vidzy.org

# --- Jellyfin (synchronisation de la bibliothèque — plugin anime-sama) ---
# JELLYFIN_BASE_URL=http://jellyfin:8096
# Clé d'API dédiée (Panneau admin Jellyfin → API Keys), distincte de celle utilisée par
# shop_backend — laisser vide désactive la synchronisation (log un avertissement, sans erreur)
JELLYFIN_API_KEY=
